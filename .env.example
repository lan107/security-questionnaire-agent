# --- Authentication (Dev Console > your app > Configuration) ---
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# Optional: act as this user instead of the app's service account
# (needs "Generate user access tokens" enabled on the app). Your user ID is in Box > Account settings.
BOX_USER_ID=
# Optional quick test: a 60-minute developer token from the Dev Console overrides the above
BOX_DEVELOPER_TOKEN=

# --- Folders (the number at the end of the folder's URL in Box) ---
# 01 Trust Center Content
TRUST_FOLDER_ID=
# 02 Deals
DEALS_FOLDER_ID=
# Optional: ask Box AI over a Hub instead of the folder's files
TRUST_HUB_ID=

# --- Review and release ---
# Box login email of the Security reviewer (can be you)
REVIEWER_LOGIN=
REVIEW_DAYS=3
# SOC2_FILE_ID and NDA_FILE_ID are printed by box_setup.py; leave NDA blank to skip Box Sign
SOC2_FILE_ID=
NDA_FILE_ID=
# Signer for the NDA (use your personal email for the demo)
PROSPECT_EMAIL=
LINK_DAYS=7
# Optional; some plans do not allow shared link passwords
LINK_PASSWORD=

# --- Runtime ---
# Parallel Box AI calls
AI_WORKERS=4
POLL_SECONDS=10
PORT=8080
# Dev Console > your app > Webhooks > Manage signature keys (only for `serve`)
WEBHOOK_PRIMARY_KEY=
WEBHOOK_SECONDARY_KEY=
